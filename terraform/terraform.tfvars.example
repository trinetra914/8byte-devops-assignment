aws_region         = "ap-south-1"
ec2_instance_type  = "t3.micro"
application_port   = 5000
app_name           = "8byte-devops-app"

vpc_cidr = "10.0.0.0/16"

public_subnet_a_cidr  = "10.0.1.0/24"
public_subnet_b_cidr  = "10.0.2.0/24"
private_subnet_a_cidr = "10.0.11.0/24"
private_subnet_b_cidr = "10.0.12.0/24"

availability_zone_a = "ap-south-1a"
availability_zone_b = "ap-south-1b"

ecr_repository_name = "8byte-devops-app"

rds_identifier    = "byte8-postgres"
rds_database_name = "eightbyte"
rds_username      = "postgres"
rds_port          = 5432

